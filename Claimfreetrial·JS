// api/claimFreeTrial.js
// POST /api/claimFreeTrial   Header: Authorization: Bearer <Firebase ID token>

const { admin, db, requireAuth, setCors } = require('./_firebaseAdmin');

module.exports = async (req, res) => {
  setCors(res, process.env.ALLOWED_ORIGIN);
  if (req.method === 'OPTIONS') return res.status(204).end();
  if (req.method !== 'POST') return res.status(405).json({ error: 'method-not-allowed' });

  try {
    const uid = await requireAuth(req);
    const userRef = db.collection('users').doc(uid);

    const result = await db.runTransaction(async (tx) => {
      const snap = await tx.get(userRef);
      const data = snap.data() || {};
      if (data.freeTrialUsed) {
        const err = new Error('استخدمت الفترة التجريبية قبل كده');
        err.status = 409;
        throw err;
      }
      const expiry = new Date();
      expiry.setMonth(expiry.getMonth() + 1);

      tx.update(userRef, {
        plan: 'pro',
        proStartAt: admin.firestore.FieldValue.serverTimestamp(),
        proExpiresAt: admin.firestore.Timestamp.fromDate(expiry),
        freeTrialUsed: true,
        freeTrialClaimedAt: admin.firestore.FieldValue.serverTimestamp(),
      });
      return { plan: 'pro', proExpiresAt: expiry.toISOString() };
    });

    res.status(200).json(result);
  } catch (e) {
    res.status(e.status || 500).json({ error: e.message || 'server-error' });
  }
};
